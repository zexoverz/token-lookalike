{
  "name": "token-lookalike",
  "version": "0.1.0",
  "description": "Spot ERC-20 tokens impersonating another token: confusable symbols, invisible characters, cloned names and vanity addresses.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zexoverz/token-lookalike.git"
  },
  "keywords": [
    "erc20",
    "token",
    "phishing",
    "homoglyph",
    "address-poisoning",
    "wallet",
    "security"
  ],
  "homepage": "https://github.com/zexoverz/token-lookalike",
  "dependencies": {
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
